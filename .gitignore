.DS_Store

# Raw inputs live on storage and are not distributed with the repository; processed
# data is regenerable from them. The site shapefile is the exception: it is small,
# it is a primary source rather than a pipeline output, and without it the repo has
# no site information at all.
data/raw/*
!data/raw/sites/
data/processed/

.claude/worktrees/
